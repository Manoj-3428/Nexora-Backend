# Copy to .env and fill in real values.

# Required
MONGODB_URI=mongodb://localhost:27017/nexora
JWT_SECRET=change-me-to-a-long-random-secret

# Optional
PORT=5000
NODE_ENV=development

# Required only in production (CORS allow-list origin)
FRONTEND_URL=https://app.nexora.example

# --- WebRTC ICE servers (GET /api/v1/rtc/ice-servers) ---
# STUN is optional (defaults to Google's public STUN).
STUN_URLS=stun:stun.l.google.com:19302
# TURN is required for reliable cross-network (cellular / symmetric-NAT) P2P.
# Preferred: ephemeral credentials via a coturn shared secret (use-auth-secret).
TURN_URLS=
TURN_SECRET=
TURN_TTL=86400
# Static fallback (used only if TURN_SECRET is unset):
TURN_USERNAME=
TURN_CREDENTIAL=
